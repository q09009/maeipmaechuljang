POSTGRES_DB=maeipmaechuljang
POSTGRES_USER=maeip
POSTGRES_PASSWORD=replace-with-a-strong-db-password
MAEIP_API_KEY=replace-with-a-long-random-api-key
MAEIP_CORS_ORIGINS=
# Docker 없이 직접 실행할 때만 필요에 따라 주석을 풉니다.
# MAEIP_BACKUP_DIR=./backups
# 웹 클라이언트가 있으면 실제 주소만 쉼표로 구분해 허용합니다.
# MAEIP_CORS_ORIGINS=https://ledger.example.com,http://192.168.0.10:3000

# Docker Compose에서는 사용하지 않습니다. Docker 없이 직접 실행할 때만 주석을 풉니다.
# DATABASE_URL=postgresql+psycopg://postgres:replace-password@127.0.0.1:5432/maeipmaechuljang
